# Nothing generated or downloaded belongs in the repository. The notebooks cache PDB downloads outside it
# (~/.cache/biology_to_research/pdb) and write scratch files to the system's temporary folder; these patterns
# catch copies made by hand or by older versions of the notebooks.
course_data/
outputs_*/
pdb_cache/
*.mrc
*.map
*.cif.gz
*.pdb.gz
*_ground_truth.csv
__pycache__/
.ipynb_checkpoints/
